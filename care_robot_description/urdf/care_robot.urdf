<?xml version="1.0"?>
<robot xmlns="http://www.ros.org/wiki/urdf" name="care_robot">

  <!-- Materials -->
  <material name="green"><color rgba="0 0.6 0 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>

  <!-- SU7 Ultra meshes at 0.12 scale; Ackermann steering; base_link is at the rear axle. -->
  <link name="base_link">
    <visual name="su7ultra_body">
      <geometry>
        <mesh filename="package://care_robot_description/meshes/su7ultra/car.dae"
              scale="0.12 0.12 0.12"/>
      </geometry>
      <origin xyz="0.1854 0 0.00288" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.64 0.26 0.15"/></geometry>
      <origin xyz="0.1787 0 0.045" rpy="0 0 0"/>
      <surface>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </surface>
    </collision>
    <inertial>
      <mass value="10"/>
      <origin xyz="0.1854 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.2" iyz="0.0" izz="0.3"/>
    </inertial>
  </link>

  <!-- Front mounted Lidar -->
  <link name="lidar">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="green"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <surface>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </surface>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Wheels -->
  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://care_robot_description/meshes/su7ultra/wheel_l.dae"
              scale="0.12 0.12 0.12"/>
      </geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0432" length="0.0386"/></geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
    </collision>
    <inertial>
      <mass value="1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0006" ixy="0.0" ixz="0.0" iyy="0.00093" iyz="0.0" izz="0.0006"/>
    </inertial>
  </link>

  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://care_robot_description/meshes/su7ultra/wheel_r.dae"
              scale="0.12 0.12 0.12"/>
      </geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0432" length="0.0386"/></geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
    </collision>
    <inertial>
      <mass value="1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0006" ixy="0.0" ixz="0.0" iyy="0.00093" iyz="0.0" izz="0.0006"/>
    </inertial>
  </link>

  <!-- Freely rolling front wheels, each mounted on a steering knuckle. -->
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://care_robot_description/meshes/su7ultra/wheel_l.dae"
              scale="0.12 0.12 0.12"/>
      </geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0432" length="0.0386"/></geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
    </collision>
    <inertial>
      <mass value="1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0006" ixy="0.0" ixz="0.0" iyy="0.00093" iyz="0.0" izz="0.0006"/>
    </inertial>
  </link>

  <link name="front_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://care_robot_description/meshes/su7ultra/wheel_r.dae"
              scale="0.12 0.12 0.12"/>
      </geometry>
    </visual>
    <collision>
      <geometry><cylinder radius="0.0432" length="0.0386"/></geometry>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
    </collision>
    <inertial>
      <mass value="1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0006" ixy="0.0" ixz="0.0" iyy="0.00093" iyz="0.0" izz="0.0006"/>
    </inertial>
  </link>

  <!-- Camera Mount and Camera -->
  <link name="camera_link">
    <visual name="camera_housing">
      <geometry>
	      	<box size="0.06 0.08 0.05"/>
      </geometry>
      <material name="black"/>
    </visual>
    <visual name="camera_mast">
      <origin xyz="-0.03 0 -0.325" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.65"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <link name="camera_link_optical"></link>
  
  <!-- Joints -->
  <joint name="base_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar"/>
    <origin xyz="0.3354 0 0.225" rpy="0 0 0"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0 0.09996 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 -0.09996 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <!-- Independent front steering implements the Ackermann inner/outer angles. -->
  <link name="front_left_steering_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_steering_link"/>
    <origin xyz="0.3588 0.09996 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.85" upper="0.85" effort="20" velocity="3"/>
    <dynamics damping="0.01"/>
  </joint>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <link name="front_right_steering_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_steering_link"/>
    <origin xyz="0.3588 -0.09996 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.85" upper="0.85" effort="20" velocity="3"/>
    <dynamics damping="0.01"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.001" friction="0.0"/>
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.3854 0 0.65" rpy="0 0 0"/>
  </joint>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
  </joint>

  <!-- Steering wheels roll without intentional lateral slip. -->
  <gazebo reference="rear_left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <fdir1>0 0 1</fdir1>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <fdir1>0 0 1</fdir1>
  </gazebo>
  <gazebo reference="front_left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <fdir1>0 0 1</fdir1>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <fdir1>0 0 1</fdir1>
  </gazebo>

  <!-- Gazebo Sim sensors and systems -->
  <gazebo reference="lidar">
    <material>Gazebo/Black</material>
    <sensor type="gpu_lidar" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Gazebo cameras look along the parent link's +X axis.  Keep the sensor
       on camera_link and use camera_link_optical only for ROS projection. -->
  <gazebo reference="camera_link">
    <sensor type="rgbd_camera" name="robot_camera_sensor">
      <pose>0 0 0 0 0 0</pose>
      <topic>robot_camera_sensor</topic>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.396</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_base>0.3588</wheel_base>
      <wheel_separation>0.19992</wheel_separation>
      <kingpin_width>0.19992</kingpin_width>
      <wheel_radius>0.0432</wheel_radius>
      <!-- Harmonic uses R_min = wheel_base / sin(steering_limit): 0.65 m. -->
      <steering_limit>0.584760869</steering_limit>
      <steer_p_gain>10.0</steer_p_gain>
      <odom_publish_frequency>30</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <min_velocity>-0.6</min_velocity>
      <max_velocity>0.6</max_velocity>
      <min_acceleration>-0.5</min_acceleration>
      <max_acceleration>0.5</max_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>
