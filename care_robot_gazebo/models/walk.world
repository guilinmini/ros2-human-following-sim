            <time>10</time>
            <pose>0 -2 1.0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>20</time>
            <pose>0 -2 1.0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>30</time>
            <pose>0 2 1.0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>35</time>
            <pose>0 2 1.0 0 0 -1.57</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
